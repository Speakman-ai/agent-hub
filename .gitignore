# Dependencies (no trailing slash — catches both directories and symlinks)
node_modules

# Database files
*.db
*.db-shm
*.db-wal

# Build output
client/dist/
mobile/.expo/
mobile/android/
mobile/ios/
mobile/*.ipa

# Environment & secrets
.env
.env.*

# Slack config (may contain tokens)
server/slack-config.json
server/slack-config.json.real
server/slack-config.json.ready

# Backup files
server/*-backup.json

# Instance-specific config (legacy location — now lives in ~/.agent-hub/data/)
server/config.json
server/projects.json

# Agent workspace context (instance-specific)
ahw/

# Uploaded files
server/uploads/
.agent-hub-images/

# OS files
.DS_Store
Thumbs.db
.worktrees/
release/
server/connection.json
server/server.log

# Claude Code instance-specific settings
.claude/settings.json
