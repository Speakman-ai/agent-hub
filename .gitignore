# Dependencies (no trailing slash — catches both directories and symlinks)
node_modules

# Database files
*.db
*.db-shm
*.db-wal

# Build output
client/dist/
mobile/.expo/
mobile/android/
mobile/ios/
mobile/*.ipa

# Environment & secrets
.env
.env.*
!.env.example

# Slack config (may contain tokens)
server/slack-config.json
server/slack-config.json.real
server/slack-config.json.ready

# Backup files
server/*-backup.json

# Instance-specific config (legacy location — now lives in ~/.agent-hub/data/)
server/config.json
server/projects.json

# Agent workspace context (instance-specific)
ahw/

# Uploaded files
server/uploads/
.agent-hub-images/

# Claude Code local settings (session-specific, may contain hooks/keys)
.claude/settings.json
# Claude Code ephemeral worktrees — created per-session by EnterWorktree.
# These contain local-only commits that won't resolve for other clones; if
# accidentally added they appear as dangling submodule gitlinks in PRs.
.claude/worktrees/

# OS files
.DS_Store
Thumbs.db
.worktrees/
release/
server/connection.json
server/active-org.json
server/remote-orgs.json
server/server.log
