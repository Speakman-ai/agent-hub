# Dependencies (no trailing slash — catches both directories and symlinks)
node_modules

# Database files
*.db
*.db-shm
*.db-wal

# Build output
client/dist/
mobile/.expo/
mobile/android/
mobile/ios/
mobile/*.ipa

# Environment & secrets
.env
.env.*
!.env.example

# Slack config (may contain tokens)
server/slack-config.json
server/slack-config.json.real
server/slack-config.json.ready

# Backup files
server/*-backup.json

# Instance-specific config (legacy location — now lives in ~/.agent-hub/data/)
server/config.json
server/projects.json
# Auto-saved per-instance agent registry — may hold engine/model config; never commit.
server/agents.json

# Agent workspace context (instance-specific)
ahw/

# Uploaded files
server/uploads/
.agent-hub-images/
.agent-hub-preview/

# Claude Code local settings (session-specific, may contain hooks/keys)
.claude/settings.json
# Claude Code ephemeral worktrees — created per-session by EnterWorktree.
# These contain local-only commits that won't resolve for other clones; if
# accidentally added they appear as dangling submodule gitlinks in PRs.
.claude/worktrees/

# Terraform — never commit state or provider caches. Lockfile (.terraform.lock.hcl)
# IS committed for reproducible provider versions.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
ops/terraform/state/
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS files
.DS_Store
Thumbs.db
.worktrees/
release/

# OpenAPI docs build output (regenerated by .github/workflows/api-docs.yml)
docs/api/_site/

# Playwright run output (HTML report, traces, blob shards) — per-run local artifacts
playwright-report/
e2e/playwright-report/
test-results/
e2e/test-results/
blob-report/
e2e/blob-report/
server/connection.json
server/active-org.json
server/remote-orgs.json
server/server.log
.codex/
.claude/
.cursor/
server/finalize/runner/runner-agent.mjs
