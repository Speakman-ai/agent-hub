{
  "version": 1,
  "projectId": "agent-hub",
  "prEnv": {
    "enabled": false,
    "preview": {
      "enabled": true,
      "captureRoutes": ["/"],
      "idleTTL": 1800,
      "compose": {
        "entryService": "client",
        "entryPort": 80,
        "file": "compose.preview.yml",
        "healthPath": "/",
        "entryWorkdir": "/app",
        "entrySourceDir": ".",
        "shadowDirs": [
          "node_modules",
          "client/node_modules",
          "server/node_modules",
          "shared/node_modules",
          "mobile/node_modules",
          "electron/node_modules"
        ]
      }
    }
  }
}
