#!/bin/sh
# Finalize spawn guard — blocks `gh pr create` when direct ship is not allowed.
GUARD_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=/dev/null
. "$GUARD_DIR/_finalize-ship-gate.sh"

REAL_GH="${AGENT_HUB_REAL_GH:-gh}"

if [ "$1" = "pr" ] && [ "$2" = "create" ]; then
  _finalize_direct_ship_gate "gh pr create" "gh_pr_create" || exit $?
fi

exec "$REAL_GH" "$@"
