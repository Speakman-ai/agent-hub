# This package relies on devDependencies (typecheck/lint/test toolchains).
# Some environments set npm `omit=dev` globally, which would make
# `cd client && npm ci` skip them. npm reads the project `.npmrc` from THIS
# package dir ONLY — it does NOT inherit the repo-root `.npmrc` — so the
# repo-root `include=dev` does not reach this install. Force it here too.
include=dev

# Network resilience for transient registry resets (npm ECONNRESET mid-install
# in CI). Same non-inheritance applies — the repo-root fetch-retry settings do
# not reach `cd client && npm ci`, so they must live here. Keep in sync with the
# repo-root `.npmrc` (guarded by server/npmrc-resilience.test.ts).
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
