{
  "expo": {
    "name": "Agent Hub",
    "slug": "agent-hub-mobile",
    "version": "1.0.0",
    "scheme": "agenthub",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agenthub.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIAppFonts": [
          "Ionicons.ttf",
          "Feather.ttf",
          "MaterialCommunityIcons.ttf",
          "MaterialIcons.ttf"
        ]
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB",
          "androidMode": "default",
          "androidCollapsedTitle": "Agent Hub"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Agent Hub to record voice messages for transcription."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf"
          ]
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030712",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E40AF"
      },
      "package": "com.agenthub.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "20b18a51-0fcc-4818-9721-e74db92bb51c"
      }
    }
  }
}
