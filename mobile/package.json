  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "index.ts",
  "scripts": {
    "pretest": "node -e \"const fs=require('fs');if(!fs.existsSync('node_modules/react/package.json')){console.error('Mobile deps missing. From repo root run: npm run install:all   (or: cd mobile && npm install)');process.exit(1)}\"",
    "generate:xterm-bundle": "node scripts/generate-xterm-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run"
  },
