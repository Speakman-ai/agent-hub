{
  "name": "agent-hub",
  "version": "1.2.1",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npx tsx index.ts",
    "dev:client": "cd client && npx vite --port 3050",
    "build": "cd client && npx vite build",
    "start": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install && cd ../mobile && npm install",
    "test": "npm run test:client && npm run test:server && npm run test:electron",
    "test:client": "cd client && npm test",
    "test:server": "cd server && npm test",
    "test:electron": "cd electron && npx vitest run",
    "dev:mobile": "cd mobile && expo start",
    "mobile": "cd mobile && expo start",
    "electron:dev": "NODE_ENV=development concurrently \"npm run dev:client\" \"sleep 3 && npx electron .\"",
    "electron:build": "npm run build && npx electron-builder --mac",
    "electron:start": "npx electron .",
    "electron:pack": "npm run build && npx electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "test:watch": "cd server && npx vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'server/**/*.ts' 'client/src/**/*.{js,jsx}' 'electron/**/*.{js,cjs}'",
    "format:check": "prettier --check 'server/**/*.ts' 'client/src/**/*.{js,jsx}' 'electron/**/*.{js,cjs}'",
    "prepare": "husky",
    "test:e2e": "cd e2e && npx playwright test",
    "test:e2e:ui": "cd e2e && npx playwright test --ui",
    "test:e2e:headed": "cd e2e && npx playwright test --headed",
    "test:e2e:report": "cd e2e && npx playwright show-report"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "build": {
    "appId": "com.agenthub.app",
    "productName": "Agent Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "server/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": null,
      "category": "public.app-category.developer-tools",
      "x64ArchFiles": "**/better-sqlite3/build/Release/test_extension.node"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "lint-staged": {
    "server/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "client/src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "concurrently": "^8.2.2",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
