# This repo relies on devDependencies for Husky, ESLint, Prettier, and Vitest.
# Some environments set npm `omit=dev` globally, which breaks `npm install`
# (prepare → husky) and pre-commit (lint-staged → eslint). Force dev installs here.
include=dev

# Network resilience for transient registry resets. CI installs (`npm ci` on
# the Finalize DinD fleet and GitHub Actions) intermittently hit
# `npm error code ECONNRESET` mid-download, which fails the whole build for a
# blip that has nothing to do with the change set. npm's defaults retry only
# twice with a short backoff; widen the retry budget + socket timeout so a
# transient reset is ridden out instead of red-failing the pipeline.
# NOTE: npm reads the *project* `.npmrc` from the package dir only — it does
# NOT walk up to this root file for `cd <pkg> && npm ci`. Each workspace
# package carries its own copy of these settings; keep them in sync (guarded
# by server/npmrc-resilience.test.ts).
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
