# Agent Hub — Docker Environment Variables
# Copy this file to .env and fill in your values.
# docker compose will automatically load .env from the project root.

# ── AI authentication ────────────────────────────────────────────
# Claude, Cursor, and Codex authentication is STRICTLY per-account: each
# Hub user configures their own credentials under Account → settings.
# There is NO host/global key and NO org-owner fallback for these engines —
# host env vars like ANTHROPIC_API_KEY / CURSOR_API_KEY / CODEX_API_KEY are
# NOT consumed for spawning agents.
#
# Gemini is the one exception — a host-wide key used for wiki embeddings.
# A per-account Gemini key (Account settings) takes precedence when present.
# GEMINI_API_KEY=...
#
# Host utility key for non-agent features (Whisper transcription, LLM
# session titles). Not used to spawn AI agents.
# OPENAI_API_KEY=sk-...

# ── Optional: API authentication ─────────────────────────────────
# AGENT_HUB_API_KEY=your-secret-key

# ── Optional: GitHub integration ─────────────────────────────────
# AGENT_HUB_BOT_GITHUB_TOKEN=ghp_...
# AGENT_HUB_PUBLIC_URL=https://your-domain.com

# ── Optional: Slack integration ──────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Optional: Codex sandbox (Hub defaults to danger bypass for container compatibility) ──
# AGENT_HUB_CODEX_DANGER_BYPASS=false

# ── Optional: session replay policy ──────────────────────────────
# Base replay retention defaults to 14 days; set 0 for keep-forever.
# AGENT_HUB_REPLAY_RETENTION_DAYS=14
# Continuous replay enforces mask-all by default. Set false for staging/test.
# AGENT_HUB_REPLAY_MASK_ALL_ENFORCED=true

# ── Optional: Web port (default 80) ─────────────────────────────
# AGENT_HUB_WEB_PORT=8080

# ── Vendor control-plane endpoints (build-time; DISABLED by default) ──
# These configure where the CLIENT bundles send telemetry / fetch downloads.
# They are inlined at BUILD time (Vite for web, Expo for mobile), so they must
# be present in the environment when `npm run build` / `eas build` runs — NOT at
# server runtime. Left UNSET, the corresponding feature is OFF: a self-hosted
# build never phones home (bug reports, session replay, and the desktop
# download/update links are simply not offered).
#
# The vendor's FIRST-PARTY release build must set these so its hosted
# web/desktop/mobile clients keep working. In the GitHub-driven deploys
# (deploy-prod-2 / deploy-dev / release-prod) they are injected from GitHub repo
# VARIABLES of the same name (Settings → Secrets and variables → Actions →
# Variables) — the URL value lives there, not in this repo. For mobile, set an
# EAS environment variable (`eas env:create`) for EXPO_PUBLIC_BUG_REPORT_ENDPOINT.
#
# Web client (Vite — read from build-shell env / GitHub repo variables):
#   VITE_BUG_REPORT_ENDPOINT   — bug-report intake, e.g. https://hub.example.com/api/bug-reports
#   VITE_REPLAY_INGEST_ENDPOINT— OPTIONAL; derives from the bug-report origin
#                                (…/api/replays) when unset. Only set to point
#                                replay ingest at a different host.
#   VITE_RELEASE_BUCKET_BASE   — desktop DMG download/update bucket base URL,
#                                e.g. https://releases.example.com
# Mobile client (Expo — inlined by Metro at build time):
#   EXPO_PUBLIC_BUG_REPORT_ENDPOINT — bug-report intake for the mobile app.
# Electron release tool (server-side; `npm run release:mac` — NOT a client bundle,
# defaults to the reference bucket so the vendor release keeps working):
#   AGENT_HUB_RELEASE_BUCKET   — override the S3 release bucket (default agent-hub-prod-releases)
#   AGENT_HUB_RELEASE_REGION   — override the S3 region (default us-east-2)

# ── Session previews (managed dev server) + local Docker stack ───
# Bind-mount paths (defaults to ~/.agent-hub/*). Use org data dir if needed:
# AGENT_HUB_HOST_DATA_DIR=/Users/you/.agent-hub/orgs/your-org-id
# AGENT_HUB_HOST_WORKSPACES_DIR=/Users/you/.agent-hub/workspaces
# AGENT_HUB_HOST_PROJECTS_DIR=/Users/you/.agent-hub/projects
# Host loopback alias for readiness polls from inside the server container:
# AGENT_HUB_PREVIEW_HEALTH_HOST=host.docker.internal
# AGENT_HUB_PREVIEW_READY_TIMEOUT_MS=600000
# macOS: when projects.json cwd is ~/projects/<repo>, bind-mount at the same path:
# AGENT_HUB_HOST_MAC_PROJECTS=/Users/you/projects
# AGENT_HUB_HOST_MAC_PROJECTS_DIR=/Users/you/projects
# AGENT_HUB_CONTAINER_MAC_PROJECTS_DIR=/Users/you/projects
# ALLOWED_ORIGINS=http://localhost,http://localhost:3050
