# Agent Hub — Docker Environment Variables
# Copy this file to .env and fill in your values.
# docker compose will automatically load .env from the project root.

# ── AI authentication ────────────────────────────────────────────
# Claude, Cursor, and Codex authentication is STRICTLY per-account: each
# Hub user configures their own credentials under Account → settings.
# There is NO host/global key and NO org-owner fallback for these engines —
# host env vars like ANTHROPIC_API_KEY / CURSOR_API_KEY / CODEX_API_KEY are
# NOT consumed for spawning agents.
#
# Gemini is the one exception — a host-wide key used for wiki embeddings.
# A per-account Gemini key (Account settings) takes precedence when present.
# GEMINI_API_KEY=...
#
# Host utility key for non-agent features (Whisper transcription, LLM
# session titles). Not used to spawn AI agents.
# OPENAI_API_KEY=sk-...

# ── Optional: API authentication ─────────────────────────────────
# AGENT_HUB_API_KEY=your-secret-key

# ── Optional: GitHub integration ─────────────────────────────────
# AGENT_HUB_BOT_GITHUB_TOKEN=ghp_...
# AGENT_HUB_PUBLIC_URL=https://your-domain.com

# ── Optional: Slack integration ──────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Optional: Codex sandbox (Hub defaults to danger bypass for container compatibility) ──
# AGENT_HUB_CODEX_DANGER_BYPASS=false

# ── Optional: Web port (default 80) ─────────────────────────────
# AGENT_HUB_WEB_PORT=8080

# ── Docker Compose local stack (worktree compose previews) ───────
# Bind-mount paths (defaults to ~/.agent-hub/*). Use org data dir if needed:
# AGENT_HUB_HOST_DATA_DIR=/Users/you/.agent-hub/orgs/your-org-id
# AGENT_HUB_HOST_WORKSPACES_DIR=/Users/you/.agent-hub/workspaces
# AGENT_HUB_HOST_PROJECTS_DIR=/Users/you/.agent-hub/projects
# Host loopback alias for readiness polls from inside the server container:
# AGENT_HUB_PREVIEW_HEALTH_HOST=host.docker.internal
# AGENT_HUB_PREVIEW_READY_TIMEOUT_MS=600000
# macOS: when projects.json cwd is ~/projects/<repo>, bind-mount at the same path:
# AGENT_HUB_HOST_MAC_PROJECTS=/Users/you/projects
# AGENT_HUB_HOST_MAC_PROJECTS_DIR=/Users/you/projects
# AGENT_HUB_CONTAINER_MAC_PROJECTS_DIR=/Users/you/projects
# ALLOWED_ORIGINS=http://localhost,http://localhost:3050
