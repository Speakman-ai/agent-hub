# Agent Hub — Docker Environment Variables
# Copy this file to .env and fill in your values.
# docker compose will automatically load .env from the project root.

# ── Required for AI features ─────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: API authentication ─────────────────────────────────
# AGENT_HUB_API_KEY=your-secret-key

# ── Optional: GitHub integration ─────────────────────────────────
# AGENT_HUB_BOT_GITHUB_TOKEN=ghp_...
# AGENT_HUB_PUBLIC_URL=https://your-domain.com

# ── Optional: Slack integration ──────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Optional: Web port (default 80) ─────────────────────────────
# AGENT_HUB_WEB_PORT=8080
