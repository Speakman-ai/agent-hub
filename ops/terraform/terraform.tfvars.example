# Copy to terraform.tfvars and adjust. Do not commit terraform.tfvars.
#
#   cp terraform.tfvars.example terraform.tfvars
#   terraform plan

aws_region  = "us-east-2"
project_name = "ryan-remote-server"

# Required — e.g. your public IP/32, or 0.0.0.0/0 in a throwaway lab (not for production)
ssh_cidr_blocks = ["203.0.113.10/32"]

# Optional: pin API key. Leave empty to auto-generate; read from output agent_hub_api_key
# after apply (also written on the host at /root/.agent-hub-bootstrap.env).
# agent_hub_api_key = "hex-or-string"

# CORS: empty or "AUTO" uses http://<this instance public IP> (IMDS) at first boot
allowed_origins = "AUTO"

# If you set a custom domain, set the full origin(s) and public URL, e.g.:
# allowed_origins    = "https://hub.example.com"
# agent_hub_public_url = "https://hub.example.com"

# docker_bootstrap = true   # default: Docker + .env under docker_app_path (default /home/agenthub/agent-hub)
#
# When docker_bootstrap is false, minimal user_data only prepares /home/<app_user>/app (no Docker, no .env here).

# ── Default Owner credentials on first launch ────────────────────────────────
# By default agent_hub_default_password = "auto" — the server generates a random
# password on first boot and writes it to <dataDir>/initial-credentials.txt
# (mode 0600). Retrieve via SSM Session Manager:
#
#   aws ssm start-session --target i-xxxx
#   sudo cat /var/lib/agent-hub/data/initial-credentials.txt   # docker
#   # or for the PM2 path:
#   sudo cat /home/agenthub/.agent-hub/data/initial-credentials.txt
#
# Override with a literal value (≥12 chars) to know the password ahead of time.
# Set to "" to disable auto-provision and require the interactive
# /api/auth/setup endpoint instead.
#
# agent_hub_default_username = "admin"
# agent_hub_default_password = "auto"

# ── PR Environments ──────────────────────────────────────────────────────────
# `enable_pr_environments` defaults to TRUE — a fresh apply provisions the full
# stack (wildcard ACM cert, Route 53 IAM policy, host nginx + certbot, SG
# ports 3100-3999, Tier-3 prEnv config). Set false on hosts that will never
# run per-PR previews. The per-piece `enable_pr_env_wildcard_cert`,
# `enable_pr_env_route53_iam`, `enable_pr_env_host_nginx` overrides remain
# (default null = follow the root flag); set them to true/false only when
# disabling a single piece for testing.
#
# enable_pr_environments = true
# cert_renewal_email     = "ops@example.com"  # required when PR-env stack on
