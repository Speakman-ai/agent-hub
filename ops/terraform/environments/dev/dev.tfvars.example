# dev: personal Agent Hub sandbox (dev AWS account).
#
# LIVE ENV DECOMMISSIONED 2026-08-17 (`terraform destroy` on this workspace).
# Templates stay so the stack can be stood back up; do not apply until that is
# an intentional revive. See `.github/workflows/deploy-dev-hub-on-main.yml`.
#
# Copy to dev.tfvars and fill in account-specific values. dev.tfvars is a
# gitignored local overlay (only prod commits its live config today); tokens
# go in secrets.tfvars.
#
#   cp environments/dev/dev.tfvars.example environments/dev/dev.tfvars
#   AWS_PROFILE=<profile> ./scripts/tf-init.sh dev
#   AWS_PROFILE=<profile> terraform plan  -var-file=environments/dev/dev.tfvars
#   AWS_PROFILE=<profile> terraform apply -var-file=environments/dev/dev.tfvars

aws_region   = "us-east-2"
project_name = "dev"
name         = "dev"

public_fqdn = "agenthub.dev.example.com"
base_domain = "dev.example.com"

enable_dedicated_alb                = true
lookup_route53_zone_in_this_account = true

# SSM-only access (no SSH, no key pair).
create_ssh_key      = false
enable_ssh_ingress  = false
enable_instance_ssm = true
ssh_cidr_blocks     = []

# Pull the published image; skip git clone + docker build. The public ECR repo
# is created out-of-band — see ops/terraform/ecr-public.tf.
bootstrap_agent_hub = true
agent_hub_image_uri = "public.ecr.aws/<ECR_PUBLIC_ALIAS>/agent-hub:main"

web_cidr_blocks         = ["0.0.0.0/0"]
alb_ingress_cidr_blocks = ["0.0.0.0/0"]

# GitHub OIDC role for CI image push is shared infra (one role per AWS account).
# Don't let the sandbox stack manage it — `terraform destroy` here should never
# break CI for other envs.
manage_github_oidc_role = false

# After CI pushes :main to ECR, GitHub Actions can restart this host via SSM.
# Two repo Variables select the target (see ecr-publish-rollout-docker-dev.yml):
#   DOCKER_DEPLOY_DEV_INSTANCE_ID — preferred by Deploy DEV Hub from main
#                                   (dev.agenthub.* / agenthub-dev-sandbox)
#   DOCKER_DEPLOY_INSTANCE_ID     — release / legacy sandbox fallback
# The resolved grant below must include whichever Variable CI will actually SSM.
#
# Prefer the tag map: it re-resolves on every apply, so rebuilding the sandbox
# under the same Name tag keeps CI working instead of failing the rollout with
# `AccessDeniedException ... ssm:SendCommand`. The raw id still works and is
# unioned in; set either or both.
enable_ci_ssm_deploy_after_ecr_push = true
ci_ssm_deploy_instance_tags         = { Name = "<DEV_SANDBOX_NAME_TAG>" }
ci_ssm_deploy_instance_id           = "<DEV_SANDBOX_INSTANCE_ID>"
# Extra ids when one workspace owns the shared CI SSM grant for both the
# release sandbox and the DEV Hub (DOCKER_DEPLOY_DEV_INSTANCE_ID).
# ci_ssm_deploy_instance_ids = ["<SANDBOX_INSTANCE_ID>", "<DEV_HUB_INSTANCE_ID>"]

# Plan-time drift guard. Asserts the grant above actually covers every box CI
# restarts, so a replaced host fails the plan (with the ids named) instead of the
# rollout. release-all.yml injects both deploy repo Variables as
# TF_VAR_ci_ssm_expected_deploy_instance_ids, so leave these unset here — set
# either only to check a local plan against specific boxes.
# ci_ssm_expected_deploy_instance_id = "<DEV_SANDBOX_INSTANCE_ID>"
# ci_ssm_expected_deploy_instance_ids = ["<SANDBOX_INSTANCE_ID>", "<DEV_HUB_INSTANCE_ID>"]

# First-launch admin credentials. The server writes a random password to
# <dataDir>/initial-credentials.txt (mode 0600) when
# agent_hub_default_password = "auto". Retrieve it after first boot via SSM.
agent_hub_default_username = "admin"
agent_hub_default_password = "auto"

# Session replay defaults. Per-project RUM settings may tighten retention.
replay_retention_days      = 14
replay_mask_all_enforced   = true

# Compute / storage sizing — keep in lockstep with cloud reality. A plan that
# reverts these would try to downsize the instance and shrink/recreate the root
# volume, destroying the Hub data dir (sessions, workspaces, preview DBs).
instance_type    = "m7i-flex.2xlarge"
root_volume_size = 500
