# Local overlay for `terraform apply`. Copy to secrets.tfvars (gitignored) and
# fill in real values. Never commit the copy.
#
# It carries two kinds of values that stay OUT of the committed prod.tfvars:
#   1. Tokens (genuine secrets).
#   2. Account-specific IDENTIFIERS (not secret, but internal-only — the deploy
#      domain, AWS account IDs, Route 53 zone ID, KMS key ID, account-scoped
#      bucket names, delegation role ARN). Keeping them here keeps the public
#      surface (prod.tfvars) clean; server/public-repo-hygiene.test.ts scans
#      prod.tfvars for exactly these identifiers.
#
# CI does not read this file. Release injects the same variables as TF_VAR_*
# (release-all.yml): identifiers from GitHub Variables, tokens from GitHub
# secrets. Empty/missing optional value → Terraform default; required
# identifiers fail-fast before plan.
#
#   Tokens (GitHub secrets — reserved for credentials only):
#     AGENT_HUB_AHLOG_TOKEN           → TF_VAR_agent_hub_ahlog_token
#     AGENT_HUB_API_KEY               → TF_VAR_agent_hub_api_key
#     TF_GITHUB_TOKEN_FOR_GIT_CLONE   → TF_VAR_github_token_for_git_clone
#
#   Identifiers (GitHub Variables — non-secret deployment identifiers):
#     PUBLIC_FQDN                     → TF_VAR_public_fqdn
#     BASE_DOMAIN                     → TF_VAR_base_domain
#     ROOT_DELEGATION_ZONE_ID         → TF_VAR_root_delegation_zone_id
#     ROOT_DELEGATION_ROLE_ARN        → TF_VAR_root_delegation_role_arn
#     HUB_DATA_KMS_KEY_ARN            → TF_VAR_hub_data_kms_key_arn
#     ALB_ACCESS_LOGS_BUCKET          → TF_VAR_alb_access_logs_bucket
#     ARTIFACTS_BUCKET_NAME           → TF_VAR_artifacts_bucket_name
#     CI_SSM_DEPLOY_INSTANCE_ID       → TF_VAR_ci_ssm_deploy_instance_id
#     FINALIZE_RUNNER_AMI_ID          → TF_VAR_finalize_runner_ami_id
#                                    (bake/SSM pin wins when present)
#     FINALIZE_CACHE_BUCKET_NAME      → TF_VAR_finalize_cache_bucket_name
#     FINALIZE_WORKTREE_BUCKET_NAME   → TF_VAR_finalize_worktree_bucket_name
#
#   cp environments/prod/secrets.tfvars.example environments/prod/secrets.tfvars
#   terraform apply -var-file=environments/prod/prod.tfvars \
#                   -var-file=environments/prod/secrets.tfvars

# ── Identifiers (GitHub Variables — non-secret) ──────────────────────────────
# public_fqdn                   = "agenthub.example.com"
# base_domain                   = "agenthub.example.com"
# root_delegation_zone_id       = "<ROOT_DELEGATION_ZONE_ID>"
# root_delegation_role_arn      = "arn:aws:iam::<ROOT_ACCOUNT_ID>:role/agenthub_env_role_assume"
# hub_data_kms_key_arn          = "arn:aws:kms:us-east-2:<PROD_ACCOUNT_ID>:key/<HUB_DATA_KMS_KEY_ID>"
# alb_access_logs_bucket        = "agent-hub-alb-logs-<PROD_ACCOUNT_ID>"
# artifacts_bucket_name         = "agent-hub-artifacts-<PROD_ACCOUNT_ID>"
# ci_ssm_deploy_instance_id     = "i-..."
# finalize_runner_ami_id        = "ami-..."
# finalize_cache_bucket_name    = "agent-hub-finalize-cache-<ACCOUNT>"
# finalize_worktree_bucket_name = "agent-hub-finalize-worktree-<ACCOUNT>"

# ── Tokens (GitHub Secrets — credentials only) ───────────────────────────────
# agent_hub_ahlog_token            = "ahlog_..."
# agent_hub_api_key                = ""
# github_token_for_git_clone       = ""
