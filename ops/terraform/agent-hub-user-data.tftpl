#!/bin/bash
set -e

# ──────────────────────────────────────────────────────────────────────────────
# Three bootstrap paths, selected by Terraform at plan time:
#   1. ECR pull   (use_ecr_pull=true)          — docker pull + run, no source
#                                                 clone. Assumes Docker + ECR
#                                                 creds helper preinstalled
#                                                 (ECS-optimized AL2023 AMI).
#   2. Docker     (use_docker_bootstrap=true)  — install Docker, git clone,
#                                                 docker build + run. Ubuntu.
#   3. PM2        (use_pm2_bootstrap=true)     — Node + PM2 on host. Ubuntu.
# ──────────────────────────────────────────────────────────────────────────────

# Detect package manager (AL2023 = dnf, Ubuntu = apt-get). Keeps the template
# portable across both AMI families.
#
# NOTE: do NOT install `curl` here. The ECS-optimized AL2023 AMI ships
# `curl-minimal` preinstalled, which provides /usr/bin/curl; asking dnf to
# install the full `curl` package triggers a hard conflict and, combined with
# `set -e`, causes cloud-init to abort before reaching the docker-pull logic
# below. Ubuntu cloud images also ship curl preinstalled, so it's safe (and
# correct) to rely on the ambient binary on both AMI families.
# `--allowerasing` is belt-and-suspenders for any future package-set drift.
if command -v dnf >/dev/null 2>&1; then
  PKG_INSTALL="dnf install -y --allowerasing"
  PKG_UPDATE="dnf -y makecache"
else
  export DEBIAN_FRONTEND=noninteractive
  PKG_UPDATE="apt-get update -y"
  PKG_INSTALL="apt-get install -y"
fi

$PKG_UPDATE
$PKG_INSTALL ca-certificates git

# AL2023: stock nginx may link libprofiler.so.0; the packaged gperftools build
# can segfault during library init, breaking `nginx -t` and any reload. When
# `ldd` shows the dependency, compile and swap in a no-op stub (source:
# ops/terraform/templates/libprofiler-stub.c, embedded as base64 below).
maybe_fix_al2023_nginx_libprofiler() {
  command -v dnf >/dev/null 2>&1 || return 0
  [ -x /usr/sbin/nginx ] || return 0
  if ! ldd /usr/sbin/nginx 2>/dev/null | grep -q libprofiler; then
    return 0
  fi

  local prof_path
  prof_path="$(PATH=/usr/sbin:/sbin:/usr/bin:/bin ldconfig -p 2>/dev/null | awk '/libprofiler\.so\.0 \(/{print $NF; exit}')"
  if [ -z "$prof_path" ] && [ -f /lib64/libprofiler.so.0 ]; then
    prof_path=/lib64/libprofiler.so.0
  fi
  if [ -z "$prof_path" ] || [ ! -f "$prof_path" ]; then
    echo "WARN: agent-hub: libprofiler stub skipped (library path not found)" >&2
    return 0
  fi

  echo "agent-hub: replacing libprofiler.so.0 with no-op stub (AL2023 nginx link bug)" >&2
  printf '%s' '${libprofiler_stub_c_b64}' | base64 -d >/tmp/libprofiler-stub.c
  $PKG_INSTALL gcc
  gcc -shared -fPIC -O2 /tmp/libprofiler-stub.c -o /tmp/libprofiler.so.0.stub -Wl,-soname,libprofiler.so.0

  if [ ! -f "$${prof_path}.bak.agenthub" ]; then
    cp -a "$prof_path" "$${prof_path}.bak.agenthub"
  fi
  install -m 0755 /tmp/libprofiler.so.0.stub "$prof_path"
  ldconfig 2>/dev/null || true
  rm -f /tmp/libprofiler-stub.c /tmp/libprofiler.so.0.stub

  if ! nginx -t >/dev/null 2>&1; then
    echo "ERROR: agent-hub: nginx -t failed after libprofiler stub; restoring upstream library" >&2
    cp -a "$${prof_path}.bak.agenthub" "$prof_path"
    ldconfig 2>/dev/null || true
    exit 1
  fi
}

# PR-env host nginx + certbot bootstrap removed in PR-Env Removal #6. See
# alb.tf for the teardown note.

%{ if use_ecr_pull }
# ── ECR pull path ───────────────────────────────────────────────────────────
# Docker is preinstalled on the ECS-optimized AL2023 AMI. Just make sure it's
# running. (Harmless on Ubuntu too if someone pins that AMI.)
systemctl enable --now docker || true
%{ endif }

%{ if use_docker_bootstrap }
$PKG_INSTALL docker.io docker-compose-plugin 2>/dev/null \
  || $PKG_INSTALL docker docker-compose-plugin
systemctl enable --now docker
%{ endif }

%{ if use_pm2_bootstrap }
$PKG_INSTALL build-essential python3 2>/dev/null \
  || $PKG_INSTALL gcc-c++ make python3
# Node + PM2 + Nginx (only when not using Docker)
curl -fsSL https://deb.nodesource.com/setup_${node_major}.x | bash -
$PKG_INSTALL nodejs
npm install -g pm2
$PKG_INSTALL nginx
maybe_fix_al2023_nginx_libprofiler
systemctl enable nginx
%{ endif }

# App user + docker group
id -u ${app_user} &>/dev/null || useradd -m -s /bin/bash ${app_user}
mkdir -p /home/${app_user}/app
chown ${app_user}:${app_user} /home/${app_user}/app
%{ if use_docker_bootstrap || use_ecr_pull }
# Add app user to the docker group so interactive SSM sessions can run docker
# commands without sudo. Root always can regardless.
usermod -aG docker ${app_user} || true
%{ endif }

# cursor-agent (optional; host).
sudo -H -u ${app_user} bash -c 'curl -fsSL https://cursor.com/install | bash' \
  || echo "cursor-agent host install failed (server still works in container)" >&2

npm install -g @openai/codex \
  || echo "codex CLI host install failed (server still works in container)" >&2

# SSM agent safety net (preinstalled on AL2023-ECS and Ubuntu EC2 already).
if [ ! -x /usr/bin/amazon-ssm-agent ] && [ ! -x /snap/bin/amazon-ssm-agent ] && [ ! -d /usr/lib/ssh/ssm ]; then
  curl -fSsL "${ssm_deb_url}" -o /tmp/ssm.deb 2>/dev/null \
    && (dpkg -i /tmp/ssm.deb 2>/dev/null || (apt-get update && apt-get install -f -y && dpkg -i /tmp/ssm.deb)) \
    || true
fi
if systemctl list-units 'amazon-ssm-agent.service' 2>/dev/null | grep -q amazon-ssm-agent; then
  systemctl enable --now amazon-ssm-agent
else
  command -v snap >/dev/null && snap start amazon-ssm-agent || true
fi

%{ if bootstrap ~}
REPO_DIR="${repo_dir}"
DATA_ROOT="${data_root_for_docker}"

# Tier-3 prEnv config writer removed in PR-Env Removal #6. See alb.tf for the
# teardown note.

%{ if use_ecr_pull ~}
# ── ECR pull branch ─────────────────────────────────────────────────────────
# No git clone, no docker build. Just pull the tagged image and run it.
IMAGE_URI="${image_uri}"

# The container image runs as the `node` user (uid/gid 1000) from node:22-slim.
# Bind mounts preserve *host* ownership, so if we create these dirs as root the
# container cannot write to them and SQLite fails with SQLITE_CANTOPEN. Create
# them with numeric 1000:1000 so the first-boot container can open the DB.
#
# `projects` holds per-project source checkouts at /home/node/projects/<slug>
# inside the container. Without this bind-mount the source lives in the
# container's writable layer and is wiped on every restart — agents then see
# an empty cwd and silently fail. See `agent-hub-user-data.tftpl` history for
# the post-mortem.
#
# `workspaces` holds per-session git worktrees at
# /home/node/.agent-hub/workspaces/<project>/<session> inside the container.
# Without this bind-mount the worktrees live in the container's writable
# layer with NO host counterpart, which means docker-compose preview bind
# mounts launched against the worktree path (the iframe a chat session opens)
# resolve to empty dirs on the host. Card 9b868252 — closes the
# session-preview-from-worktree gap that PR #1074 explicitly did not fix.
#
# ⚠️ Upgrade note (clean-cut migration): on the first restart after this
# change lands, the bind-mount shadows any in-container worktrees that
# existed in the prior container's writable layer. Per-session worktrees
# are ephemeral by design — the next session-touch re-clones from origin
# via `ensureSessionWorkspace`'s zombie-clone handler — so no operator
# action is required, but in-flight sessions will see their worktree
# regenerated on next access. Persistent data (DB rows, kanban, wiki,
# project checkouts) lives under `data`/`projects` which are bind-mounted
# already and are NOT affected.
install -d -m 0755 -o 1000 -g 1000 \
  "$DATA_ROOT/data" "$DATA_ROOT/uploads" "$DATA_ROOT/projects" "$DATA_ROOT/workspaces"

# Write the .env file — same contract as the docker-build path, same server
# reads it, so switching bootstrap modes is transparent to the app.
install -d -m 0755 -o ${app_user} -g ${app_user} "$REPO_DIR"
if [ -n "${docker_env_b64}" ]; then
  umask 077
  printf '%s' "${docker_env_b64}" | base64 -d > "$REPO_DIR/.env"
  chown ${app_user}:${app_user} "$REPO_DIR/.env"
  chmod 600 "$REPO_DIR/.env"
fi

# Anonymous pull from ECR Public — no docker login needed. Retry a couple
# times in case the image was just pushed and the CDN is still warming.
for i in 1 2 3; do
  docker pull "$IMAGE_URI" && break
  echo "docker pull failed (attempt $i); retrying in 10s..." >&2
  sleep 10
done

# Install a systemd-managed container instead of `docker run --restart=unless-stopped`.
# Rationale: the daemon's auto-restart simply re-launches the *cached* image, which
# means after CI pushes a new `:main` the box keeps running the stale digest until
# someone SSMs in and manually pulls. This unit re-runs `docker pull` on every
# start (boot, manual restart, redeploy) so a host reboot is enough to pick up
# new image tags.
cat >/usr/local/bin/agenthub-server-run.sh <<RUNSCRIPT
#!/bin/bash
set -e
IMAGE_URI="$IMAGE_URI"
REPO_DIR="$REPO_DIR"
DATA_ROOT="$DATA_ROOT"
APP_PORT="${app_port}"

# Pull-on-start: cheap when the digest is unchanged (a few hundred bytes for the
# manifest), and the only correctness-preserving way to redeploy on reboot.
#
# CRITICAL: this loop MUST exit non-zero if all attempts fail. The original
# implementation fell through to `exec docker run` on a pull failure, which
# silently launched the container on the stale cached image — and systemd +
# CI both reported success. Observed 2026-05-11: dev sandbox stuck on v1.16.0
# for 3 days under disk-full conditions because pull failures were swallowed.
# See kanban card 89903017 for the post-mortem.
PULL_OK=0
for i in 1 2 3; do
  if docker pull --quiet "\$IMAGE_URI"; then
    PULL_OK=1
    break
  fi
  echo "docker pull failed (attempt \$i); retrying in 10s..." >&2
  sleep 10
done
if [ "\$PULL_OK" != "1" ]; then
  echo "FATAL: docker pull \$IMAGE_URI failed after 3 attempts. Refusing to start with stale local image." >&2
  echo "       Check disk space (df -h /var/lib/docker) and ECR connectivity." >&2
  exit 1
fi

docker rm -f agenthub-server 2>/dev/null || true
# PR-env docker-socket-bind variant removed in PR-Env Removal #6. See alb.tf
# for the teardown note.
exec docker run --rm --name agenthub-server \
  -p "\$APP_PORT:3051" \
  -v "\$DATA_ROOT/data:/data" -v "\$DATA_ROOT/uploads:/app/uploads" \
  -v "\$DATA_ROOT/projects:/home/node/projects" \
  -v "\$DATA_ROOT/workspaces:/home/node/.agent-hub/workspaces" \
  -e "AGENT_HUB_HOST_PROJECTS_DIR=\$DATA_ROOT/projects" \
  -e "AGENT_HUB_HOST_WORKSPACES_DIR=\$DATA_ROOT/workspaces" \
  --env-file "\$REPO_DIR/.env" \
  "\$IMAGE_URI"
RUNSCRIPT
chmod 0755 /usr/local/bin/agenthub-server-run.sh

cat >/etc/systemd/system/agenthub-server.service <<'UNIT'
[Unit]
Description=Agent Hub server (Docker container, pull-on-start)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f agenthub-server
# Reap dangling images, containers, build cache, and volumes older than 24h
# before each restart. The just-pulled `:main` is preserved (it's tagged +
# fresh), but the previous untagged `:main` digests left over from prior
# pushes get GC'd along with build-cache layers and orphan containers
# (e.g. stale ecs-agent). Without this sweep we have lost the dev sandbox
# to disk-full → docker pull → ALB unhealthy 502 multiple times (see kanban
# cards b2528863 and 8b59c789 for post-mortems).
# `-f` (force) is required because prune is interactive by default.
# `--filter until=24h` shields freshly-pulled artifacts from the sweep
# (system + image + builder prune all honor it; container/volume prune do
# not, but only stopped/dangling targets are reaped so the running
# container and bind mounts are safe).
# `-` prefix makes each step tolerant of prune failures (e.g. no images yet).
ExecStartPre=-/usr/bin/docker container prune -f
ExecStartPre=-/usr/bin/docker image prune -af --filter until=24h
ExecStartPre=-/usr/bin/docker builder prune -af --filter until=24h
ExecStartPre=-/usr/bin/docker volume prune -f
ExecStart=/usr/local/bin/agenthub-server-run.sh
ExecStop=/usr/bin/docker stop -t 30 agenthub-server
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
UNIT

# Daily docker GC timer — the ExecStartPre sweep above only fires when the
# unit restarts. If the container stays up for days while CI keeps pushing
# new `:main` digests, overlay2 + build cache drift up unbounded between
# restarts. This timer runs the same prune chain at 03:00 UTC daily so the
# sandbox reclaims disk without needing a deploy to trigger it.
cat >/usr/local/bin/agenthub-docker-gc.sh <<'GCSCRIPT'
#!/usr/bin/env bash
# Best-effort: each step is independent and a failure of one (e.g. nothing
# to prune) must not block the rest.
set +e
/usr/bin/docker container prune -f
/usr/bin/docker image prune -af --filter until=24h
/usr/bin/docker builder prune -af --filter until=24h
/usr/bin/docker volume prune -f
df -h / | tail -1
exit 0
GCSCRIPT
chmod 0755 /usr/local/bin/agenthub-docker-gc.sh

cat >/etc/systemd/system/agenthub-docker-gc.service <<'GCUNIT'
[Unit]
Description=Agent Hub daily docker GC (image/container/builder/volume prune)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/agenthub-docker-gc.sh
GCUNIT

cat >/etc/systemd/system/agenthub-docker-gc.timer <<'GCTIMER'
[Unit]
Description=Run agenthub-docker-gc daily at 03:00 UTC

[Timer]
OnCalendar=*-*-* 03:00:00 UTC
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
GCTIMER

systemctl daemon-reload
systemctl enable --now agenthub-server.service
systemctl enable --now agenthub-docker-gc.timer

# Surface the running image + tag for debugging.
sleep 3
docker ps --filter name=agenthub-server --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}' || true
%{ else ~}
# ── Legacy clone+build branch (requires TF_VAR_github_token_for_git_clone) ──
sudo -H -u ${app_user} bash -c "mkdir -p \$(dirname \"${repo_dir}\")"
if [ -d "$REPO_DIR/.git" ]; then
  sudo -H -u ${app_user} bash -c "set -e; export GIT_TERMINAL_PROMPT=0; cd $REPO_DIR; git remote update; git fetch origin; git checkout ${git_ref}; git pull --ff-only origin ${git_ref} || true"
else
  sudo -H -u ${app_user} bash -c "set -euo pipefail; export GIT_TERMINAL_PROMPT=0; git clone --depth 1 --branch ${git_ref} '${git_url}' $REPO_DIR" \
    || { echo "ERROR: git clone failed. If the repo is private, set TF_VAR_github_token_for_git_clone, then re-apply. See variables-bootstrap.tf. Or switch to the ECR-pull path by setting agent_hub_image_uri." >&2; exit 1; }
fi

%{ if use_docker_bootstrap ~}
# See ECR-pull branch comment: container runs as uid/gid 1000, bind mounts
# preserve host ownership, so creating these as root would crash-loop on
# SQLITE_CANTOPEN. Match the image's runtime uid. `projects` mirrors the
# ECR-pull branch — per-project source checkouts must persist across
# container restarts. `workspaces` makes per-session git worktrees host-
# visible so docker-compose previews launched from session worktrees
# (the iframe a chat session opens) can bind-mount source — without this
# the daemon resolves the bind mount against an empty dir on the host.
# Card 9b868252; see the ECR-pull branch comment for the upgrade note.
install -d -m 0755 -o 1000 -g 1000 \
  "$DATA_ROOT/data" "$DATA_ROOT/uploads" "$DATA_ROOT/projects" "$DATA_ROOT/workspaces"
if [ -n "${docker_env_b64}" ]; then
  umask 077
  printf '%s' "${docker_env_b64}" | base64 -d > $REPO_DIR/.env
  chown ${app_user}:${app_user} $REPO_DIR/.env
  chmod 600 $REPO_DIR/.env
fi
docker rm -f agenthub-server 2>/dev/null || true
cd "$REPO_DIR" && DOCKER_BUILDKIT=1 docker build -t agenthub:local -f server/Dockerfile .
cd "$REPO_DIR" && docker run -d --name agenthub-server --restart unless-stopped \
  -p ${app_port}:3051 \
  -v "$DATA_ROOT/data:/data" -v "$DATA_ROOT/uploads:/app/uploads" \
  -v "$DATA_ROOT/projects:/home/node/projects" \
  -v "$DATA_ROOT/workspaces:/home/node/.agent-hub/workspaces" \
  -e "AGENT_HUB_HOST_PROJECTS_DIR=$DATA_ROOT/projects" \
  -e "AGENT_HUB_HOST_WORKSPACES_DIR=$DATA_ROOT/workspaces" \
  --env-file "$REPO_DIR/.env" \
  agenthub:local
%{ endif ~}

%{ if use_pm2_bootstrap ~}
sudo -H -u ${app_user} bash -c "set -e; cd $REPO_DIR; if [ -x scripts/ensure-cursor-agent.sh ]; then bash scripts/ensure-cursor-agent.sh; fi; if [ -x scripts/ensure-codex.sh ]; then bash scripts/ensure-codex.sh; fi"
sudo -H -u ${app_user} bash -c "set -e; cd $REPO_DIR; npm install --include=dev; (cd server && npm install --include=dev); (cd client && npm install --include=dev && npm run build)"
mkdir -p /home/${app_user}/.pm2
chown -R ${app_user}:${app_user} /home/${app_user}/.pm2
sudo -H -u ${app_user} bash -c "mkdir -p $REPO_DIR/ops"
if [ -n "${env_b64}" ]; then
  printf '%s' "${env_b64}" | base64 -d > $REPO_DIR/ops/.bootstrap-runtime.env
  chmod 600 $REPO_DIR/ops/.bootstrap-runtime.env
  chown ${app_user}:${app_user} $REPO_DIR/ops/.bootstrap-runtime.env
fi
sudo -H -u ${app_user} bash -lc "set -e; cd $REPO_DIR; if [ -f ops/.bootstrap-runtime.env ]; then set -a; . ./ops/.bootstrap-runtime.env; set +a; fi; pm2 delete agent-hub 2>/dev/null || true; pm2 start ecosystem.config.cjs; pm2 save"
if [ -x /usr/bin/pm2 ]; then
  ( sudo -H -u ${app_user} bash -lc "pm2 save; pm2 startup" 2>&1 | grep "sudo" | head -1 | sh ) 2>/dev/null || true
fi
%{ endif ~}
%{ endif ~}
%{ endif ~}
