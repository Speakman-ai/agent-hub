#!/bin/bash
set -e

# ──────────────────────────────────────────────────────────────────────────────
# Three bootstrap paths, selected by Terraform at plan time:
#   1. ECR pull   (use_ecr_pull=true)          — docker pull + run, no source
#                                                 clone. Assumes Docker + ECR
#                                                 creds helper preinstalled
#                                                 (ECS-optimized AL2023 AMI).
#   2. Docker     (use_docker_bootstrap=true)  — install Docker, git clone,
#                                                 docker build + run. Ubuntu.
#   3. PM2        (use_pm2_bootstrap=true)     — Node + PM2 on host. Ubuntu.
# ──────────────────────────────────────────────────────────────────────────────

# Detect package manager (AL2023 = dnf, Ubuntu = apt-get). Keeps the template
# portable across both AMI families.
#
# NOTE: do NOT install `curl` here. The ECS-optimized AL2023 AMI ships
# `curl-minimal` preinstalled, which provides /usr/bin/curl; asking dnf to
# install the full `curl` package triggers a hard conflict and, combined with
# `set -e`, causes cloud-init to abort before reaching the docker-pull logic
# below. Ubuntu cloud images also ship curl preinstalled, so it's safe (and
# correct) to rely on the ambient binary on both AMI families.
# `--allowerasing` is belt-and-suspenders for any future package-set drift.
if command -v dnf >/dev/null 2>&1; then
  PKG_INSTALL="dnf install -y --allowerasing"
  PKG_UPDATE="dnf -y makecache"
else
  export DEBIAN_FRONTEND=noninteractive
  PKG_UPDATE="apt-get update -y"
  PKG_INSTALL="apt-get install -y"
fi

$PKG_UPDATE
$PKG_INSTALL ca-certificates git

%{ if pr_env_enabled ~}
# ── PR-env mode: host nginx + certbot for per-PR preview environments ──────
# Host nginx terminates TLS (using the wildcard ACM cert provisioned by PR 1
# via certbot DNS-01 against Route 53) and reverse-proxies to per-PR
# containers listening on 3100-3999 on the host loopback. The Hub control
# plane drops one fragment per active PR into
# /etc/nginx/conf.d/agent-hub-pr-*.conf and triggers `nginx -t` +
# `systemctl reload nginx` via the narrow sudoers.d allowlist below.
#
# Package note: the certbot Route 53 DNS plugin is `python3-certbot-dns-route53`
# on both AL2023 (`dnf`) and Ubuntu (`apt`). The shorter name
# `python3-certbot-route53` does not exist in either repo and trips `set -e`,
# so the literal package name below MUST stay in sync with the AWS-published
# tutorial. See: https://docs.aws.amazon.com/linux/al2023/ug/SSL-on-amazon-linux-2023.html
$PKG_INSTALL nginx certbot python3-certbot-dns-route53
systemctl enable --now nginx

# Base vhost: include /etc/nginx/conf.d/agent-hub-pr-*.conf so the Hub can
# drop per-PR fragments without rewriting the main config. We write to
# /etc/nginx/conf.d/ (NOT /etc/nginx/sites-enabled/) because that is the
# directory included by AL2023's stock nginx.conf and by Ubuntu's. The
# Debian-style sites-available/sites-enabled split is NOT pulled in by
# AL2023's default config, so files dropped there sit on disk and are
# silently never loaded.
install -d -m 0755 /etc/nginx/conf.d
cat >/etc/nginx/conf.d/agent-hub-pr-base.conf <<'NGINXBASE'
${pr_env_base_nginx_conf}
NGINXBASE

# sudoers.d allowlist — narrow set of binaries the Hub container needs to
# reload nginx and run certbot. Heredoc delimiter is unquoted so Terraform
# expands ${app_user} at plan time (the file written to disk contains the
# concrete user, not the literal placeholder).
#
# WARNING: do NOT widen this allowlist to include shells, package managers,
# or any binary with shell-escape ability (find -exec, awk system(), perl
# -e, etc.). Each entry is matched as a fully-qualified command + literal
# argument prefix; sudoers will refuse other invocations.
cat >/etc/sudoers.d/agenthub-pr-env <<SUDOERS
${app_user} ALL=(root) NOPASSWD: /usr/sbin/nginx -t
${app_user} ALL=(root) NOPASSWD: /bin/systemctl reload nginx
${app_user} ALL=(root) NOPASSWD: /usr/bin/certbot
SUDOERS
chmod 0440 /etc/sudoers.d/agenthub-pr-env
visudo -cf /etc/sudoers.d/agenthub-pr-env >/dev/null

# Validate the dropped config and reload so the new include takes effect
# immediately, instead of waiting for the next reboot or unrelated reload.
nginx -t && systemctl reload nginx

# ── First-boot wildcard cert issuance (certbot --dns-route53) ──────────────
# Issue a wildcard cert for *.${pr_env_preview_host} on first boot if one is
# not already on disk. The IAM role attached to this instance (PR 1 of the
# series) already has Route 53 perms; certbot's dns-route53 plugin reads them
# from EC2 instance metadata via boto3, so no static access key needs to be
# exported into the env.
#
# `--cert-name ${pr_env_preview_host}` pins the lineage directory name so the
# resulting cert lands at /etc/letsencrypt/live/${pr_env_preview_host}/ —
# matching the certPath/keyPath values written into the Tier-3 config.json
# above and consumed by the per-PR nginx fragments at runtime. Without
# --cert-name, certbot would name the lineage after the first -d argument
# (`*.<host>`), producing an unpredictable on-disk path.
#
# Idempotent: the existence check below skips reissuance on every reboot or
# user-data re-run, which is critical because Let's Encrypt enforces a
# 5-duplicate-certificates-per-week rate limit. Daily renewal is owned by the
# Hub server itself (server/container-pool/cert-renewal-heartbeat.ts) — no
# system cron entry needed here.
if [ ! -f "/etc/letsencrypt/live/${pr_env_preview_host}/fullchain.pem" ]; then
  certbot certonly \
    --dns-route53 \
    --non-interactive \
    --agree-tos \
    --cert-name "${pr_env_preview_host}" \
    -d "*.${pr_env_preview_host}" \
    -m "${cert_renewal_email}" \
    || echo "WARN: certbot --dns-route53 failed at first boot; per-PR vhosts will be unavailable until the cert is issued. Check cloud-init logs and Route 53 IAM perms." >&2
fi
%{ endif ~}

%{ if use_ecr_pull }
# ── ECR pull path ───────────────────────────────────────────────────────────
# Docker is preinstalled on the ECS-optimized AL2023 AMI. Just make sure it's
# running. (Harmless on Ubuntu too if someone pins that AMI.)
systemctl enable --now docker || true
%{ endif }

%{ if use_docker_bootstrap }
$PKG_INSTALL docker.io docker-compose-plugin 2>/dev/null \
  || $PKG_INSTALL docker docker-compose-plugin
systemctl enable --now docker
%{ endif }

%{ if use_pm2_bootstrap }
$PKG_INSTALL build-essential python3 2>/dev/null \
  || $PKG_INSTALL gcc-c++ make python3
# Node + PM2 + Nginx (only when not using Docker)
curl -fsSL https://deb.nodesource.com/setup_${node_major}.x | bash -
$PKG_INSTALL nodejs
npm install -g pm2
$PKG_INSTALL nginx
systemctl enable nginx
%{ endif }

# App user + docker group
id -u ${app_user} &>/dev/null || useradd -m -s /bin/bash ${app_user}
mkdir -p /home/${app_user}/app
chown ${app_user}:${app_user} /home/${app_user}/app
%{ if use_docker_bootstrap || use_ecr_pull }
# Add app user to the docker group so interactive SSM sessions can run docker
# commands without sudo. Root always can regardless.
usermod -aG docker ${app_user} || true
%{ endif }

# cursor-agent (optional; host).
sudo -H -u ${app_user} bash -c 'curl -fsSL https://cursor.com/install | bash' \
  || echo "cursor-agent host install failed (server still works in container)" >&2

# SSM agent safety net (preinstalled on AL2023-ECS and Ubuntu EC2 already).
if [ ! -x /usr/bin/amazon-ssm-agent ] && [ ! -x /snap/bin/amazon-ssm-agent ] && [ ! -d /usr/lib/ssh/ssm ]; then
  curl -fSsL "${ssm_deb_url}" -o /tmp/ssm.deb 2>/dev/null \
    && (dpkg -i /tmp/ssm.deb 2>/dev/null || (apt-get update && apt-get install -f -y && dpkg -i /tmp/ssm.deb)) \
    || true
fi
if systemctl list-units 'amazon-ssm-agent.service' 2>/dev/null | grep -q amazon-ssm-agent; then
  systemctl enable --now amazon-ssm-agent
else
  command -v snap >/dev/null && snap start amazon-ssm-agent || true
fi

%{ if bootstrap ~}
REPO_DIR="${repo_dir}"
DATA_ROOT="${data_root_for_docker}"

%{ if pr_env_enabled ~}
# ── Tier-3 prEnv config (host-only paths) ──────────────────────────────────
# Writes the operator-not-UI-editable portion of the PR-env config (preview
# hostname, host-side data/files dirs, nginx paths, port range, Route 53
# zone) to the canonical Agent Hub `<dataDir>/config.json` on first boot.
# The server's runtime resolver
# (server/container-pool/pr-env-runtime.ts) merges these file-block values
# with the encrypted Tier-1+2 fields it reads from SQLite (GitHub App
# creds, Route 53 IAM keys, repoFullName, certRenewalLive) — which the
# operator enters via Settings → PR Environments after first boot. Same
# `printf | base64 -d` pattern as the .env writes below so the
# render-time secrecy contract (b64 over the wire, mode 0600 on disk) is
# uniform across every templated file.
%{ if use_ecr_pull || use_docker_bootstrap ~}
# Docker bootstrap: dataDir is bind-mounted at $DATA_ROOT/data → /data in
# the container. Owner must be 1000:1000 to match the container's `node`
# user (uid 1000) — same convention as the data + uploads dirs created
# in each branch below.
PR_ENV_CONFIG_DIR="$DATA_ROOT/data"
PR_ENV_CONFIG_OWNER="1000:1000"
%{ else ~}
# PM2 bootstrap: dataDir is the host operator user's home — server reads
# ~/.agent-hub/data/config.json directly off disk.
PR_ENV_CONFIG_DIR="/home/${app_user}/.agent-hub/data"
PR_ENV_CONFIG_OWNER="${app_user}:${app_user}"
%{ endif ~}
install -d -m 0755 "$PR_ENV_CONFIG_DIR"
if [ -n "${config_json_b64}" ]; then
  umask 077
  printf '%s' "${config_json_b64}" | base64 -d > "$PR_ENV_CONFIG_DIR/config.json"
  chown "$PR_ENV_CONFIG_OWNER" "$PR_ENV_CONFIG_DIR/config.json"
  chmod 600 "$PR_ENV_CONFIG_DIR/config.json"
fi
%{ endif ~}

%{ if use_ecr_pull ~}
# ── ECR pull branch ─────────────────────────────────────────────────────────
# No git clone, no docker build. Just pull the tagged image and run it.
IMAGE_URI="${image_uri}"

# The container image runs as the `node` user (uid/gid 1000) from node:22-slim.
# Bind mounts preserve *host* ownership, so if we create these dirs as root the
# container cannot write to them and SQLite fails with SQLITE_CANTOPEN. Create
# them with numeric 1000:1000 so the first-boot container can open the DB.
#
# `projects` holds per-project source checkouts at /home/node/projects/<slug>
# inside the container. Without this bind-mount the source lives in the
# container's writable layer and is wiped on every restart — agents then see
# an empty cwd and silently fail. See `agent-hub-user-data.tftpl` history for
# the post-mortem.
install -d -m 0755 -o 1000 -g 1000 "$DATA_ROOT/data" "$DATA_ROOT/uploads" "$DATA_ROOT/projects"

# Write the .env file — same contract as the docker-build path, same server
# reads it, so switching bootstrap modes is transparent to the app.
install -d -m 0755 -o ${app_user} -g ${app_user} "$REPO_DIR"
if [ -n "${docker_env_b64}" ]; then
  umask 077
  printf '%s' "${docker_env_b64}" | base64 -d > "$REPO_DIR/.env"
  chown ${app_user}:${app_user} "$REPO_DIR/.env"
  chmod 600 "$REPO_DIR/.env"
fi

# Anonymous pull from ECR Public — no docker login needed. Retry a couple
# times in case the image was just pushed and the CDN is still warming.
for i in 1 2 3; do
  docker pull "$IMAGE_URI" && break
  echo "docker pull failed (attempt $i); retrying in 10s..." >&2
  sleep 10
done

# Install a systemd-managed container instead of `docker run --restart=unless-stopped`.
# Rationale: the daemon's auto-restart simply re-launches the *cached* image, which
# means after CI pushes a new `:main` the box keeps running the stale digest until
# someone SSMs in and manually pulls. This unit re-runs `docker pull` on every
# start (boot, manual restart, redeploy) so a host reboot is enough to pick up
# new image tags.
cat >/usr/local/bin/agenthub-server-run.sh <<RUNSCRIPT
#!/bin/bash
set -e
IMAGE_URI="$IMAGE_URI"
REPO_DIR="$REPO_DIR"
DATA_ROOT="$DATA_ROOT"
APP_PORT="${app_port}"

# Pull-on-start: cheap when the digest is unchanged (a few hundred bytes for the
# manifest), and the only correctness-preserving way to redeploy on reboot.
for i in 1 2 3; do
  docker pull --quiet "\$IMAGE_URI" && break
  echo "docker pull failed (attempt \$i); retrying in 10s..." >&2
  sleep 10
done

docker rm -f agenthub-server 2>/dev/null || true
%{ if pr_env_enabled ~}
# PR-env mode: bind-mount the host docker socket into the container so the
# Hub can spin up per-PR preview containers, and add --add-host so the
# container can reach the host nginx (which terminates TLS for the wildcard
# preview hostname) over the gateway interface. --group-add gives the
# container's `node` user (uid/gid 1000) supplementary access to the host's
# docker GID — the GID is host-distro-specific (commonly 999 on AL2023, can
# differ on Ubuntu) so we resolve it dynamically at runtime.
#
# Fail loudly if the socket is missing or unreadable. Earlier revisions
# fell back to `|| echo 0`, which silently set --group-add 0 (root group)
# on every restart and produced a container that bind-mounts the socket
# but cannot actually use it — set -e + Restart=always then masked the
# real bug behind a green systemd unit. Surface it instead: if the socket
# isn't there, this whole feature is broken and the operator needs to
# know.
#
# WARNING: this gives the Hub container root-equivalent access to the host.
# Acceptable for trusted single-tenant Hub deployments only.
DOCKER_SOCK_GID=\$(stat -c %g /var/run/docker.sock)
if [ -z "\$DOCKER_SOCK_GID" ] || [ "\$DOCKER_SOCK_GID" = "0" ]; then
  echo "ERROR: /var/run/docker.sock GID resolved to '\$DOCKER_SOCK_GID' (missing or root). Refusing to start with --group-add 0; install Docker on the host or disable enable_pr_env_host_nginx." >&2
  exit 1
fi
# PR-env validator + per-PR vhost dispatch needs visibility into the host's
# nginx config, the wildcard cert, and the host PID namespace:
#   - /etc/nginx       (rw): drop per-PR vhost files into conf.d so the host
#                            nginx (which already includes conf.d/*.conf via
#                            the base vhost) picks them up on reload.
#   - /etc/letsencrypt (ro): the validator confirms the wildcard cert exists
#                            at the path the per-PR vhosts will reference.
#   - --pid=host           : the validator runs `pgrep nginx`/`systemctl
#                            is-active nginx` to confirm the host's nginx is
#                            up. Without --pid=host the container has its own
#                            PID namespace and both checks falsely fail.
exec docker run --rm --name agenthub-server \
  -p "\$APP_PORT:3051" \
  -v "\$DATA_ROOT/data:/data" -v "\$DATA_ROOT/uploads:/app/uploads" \
  -v "\$DATA_ROOT/projects:/home/node/projects" \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v /etc/nginx:/etc/nginx \
  -v /etc/letsencrypt:/etc/letsencrypt:ro \
  --pid=host \
  --group-add "\$DOCKER_SOCK_GID" \
  --add-host host.docker.internal:host-gateway \
  --env-file "\$REPO_DIR/.env" \
  "\$IMAGE_URI"
%{ else ~}
exec docker run --rm --name agenthub-server \
  -p "\$APP_PORT:3051" \
  -v "\$DATA_ROOT/data:/data" -v "\$DATA_ROOT/uploads:/app/uploads" \
  -v "\$DATA_ROOT/projects:/home/node/projects" \
  --env-file "\$REPO_DIR/.env" \
  "\$IMAGE_URI"
%{ endif ~}
RUNSCRIPT
chmod 0755 /usr/local/bin/agenthub-server-run.sh

cat >/etc/systemd/system/agenthub-server.service <<'UNIT'
[Unit]
Description=Agent Hub server (Docker container, pull-on-start)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f agenthub-server
ExecStart=/usr/local/bin/agenthub-server-run.sh
ExecStop=/usr/bin/docker stop -t 30 agenthub-server
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now agenthub-server.service

# Surface the running image + tag for debugging.
sleep 3
docker ps --filter name=agenthub-server --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}' || true
%{ else ~}
# ── Legacy clone+build branch (requires TF_VAR_github_token_for_git_clone) ──
sudo -H -u ${app_user} bash -c "mkdir -p \$(dirname \"${repo_dir}\")"
if [ -d "$REPO_DIR/.git" ]; then
  sudo -H -u ${app_user} bash -c "set -e; export GIT_TERMINAL_PROMPT=0; cd $REPO_DIR; git remote update; git fetch origin; git checkout ${git_ref}; git pull --ff-only origin ${git_ref} || true"
else
  sudo -H -u ${app_user} bash -c "set -euo pipefail; export GIT_TERMINAL_PROMPT=0; git clone --depth 1 --branch ${git_ref} '${git_url}' $REPO_DIR" \
    || { echo "ERROR: git clone failed. If the repo is private, set TF_VAR_github_token_for_git_clone, then re-apply. See variables-bootstrap.tf. Or switch to the ECR-pull path by setting agent_hub_image_uri." >&2; exit 1; }
fi

%{ if use_docker_bootstrap ~}
# See ECR-pull branch comment: container runs as uid/gid 1000, bind mounts
# preserve host ownership, so creating these as root would crash-loop on
# SQLITE_CANTOPEN. Match the image's runtime uid. `projects` mirrors the
# ECR-pull branch — per-project source checkouts must persist across
# container restarts.
install -d -m 0755 -o 1000 -g 1000 "$DATA_ROOT/data" "$DATA_ROOT/uploads" "$DATA_ROOT/projects"
if [ -n "${docker_env_b64}" ]; then
  umask 077
  printf '%s' "${docker_env_b64}" | base64 -d > $REPO_DIR/.env
  chown ${app_user}:${app_user} $REPO_DIR/.env
  chmod 600 $REPO_DIR/.env
fi
docker rm -f agenthub-server 2>/dev/null || true
cd "$REPO_DIR" && DOCKER_BUILDKIT=1 docker build -t agenthub:local -f server/Dockerfile .
cd "$REPO_DIR" && docker run -d --name agenthub-server --restart unless-stopped \
  -p ${app_port}:3051 \
  -v "$DATA_ROOT/data:/data" -v "$DATA_ROOT/uploads:/app/uploads" \
  -v "$DATA_ROOT/projects:/home/node/projects" \
  --env-file "$REPO_DIR/.env" \
  agenthub:local
%{ endif ~}

%{ if use_pm2_bootstrap ~}
sudo -H -u ${app_user} bash -c "set -e; cd $REPO_DIR; if [ -x scripts/ensure-cursor-agent.sh ]; then bash scripts/ensure-cursor-agent.sh; fi"
sudo -H -u ${app_user} bash -c "set -e; cd $REPO_DIR; npm install --include=dev; (cd server && npm install --include=dev); (cd client && npm install --include=dev && npm run build)"
mkdir -p /home/${app_user}/.pm2
chown -R ${app_user}:${app_user} /home/${app_user}/.pm2
sudo -H -u ${app_user} bash -c "mkdir -p $REPO_DIR/ops"
if [ -n "${env_b64}" ]; then
  printf '%s' "${env_b64}" | base64 -d > $REPO_DIR/ops/.bootstrap-runtime.env
  chmod 600 $REPO_DIR/ops/.bootstrap-runtime.env
  chown ${app_user}:${app_user} $REPO_DIR/ops/.bootstrap-runtime.env
fi
sudo -H -u ${app_user} bash -lc "set -e; cd $REPO_DIR; if [ -f ops/.bootstrap-runtime.env ]; then set -a; . ./ops/.bootstrap-runtime.env; set +a; fi; pm2 delete agent-hub 2>/dev/null || true; pm2 start ecosystem.config.cjs; pm2 save"
if [ -x /usr/bin/pm2 ]; then
  ( sudo -H -u ${app_user} bash -lc "pm2 save; pm2 startup" 2>&1 | grep "sudo" | head -1 | sh ) 2>/dev/null || true
fi
%{ endif ~}
%{ endif ~}
%{ endif ~}
